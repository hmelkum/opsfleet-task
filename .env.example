# Copy to .env and fill in the two required values marked REQUIRED.
# Hostnames below are for running services on the host; compose.yml overrides them
# with the container names (postgres, backend, agent).

# =====================================================================
# Shared
# =====================================================================
ENV=dev

BACKEND_PORT=8080
AGENT_PORT=8090

# Observability: OpenTelemetry traces over OTLP/HTTP. Empty: spans are created but not exported.
# To inspect traces, run Jaeger (see README) and set this to http://host.docker.internal:4318 when
# the services run in compose (Docker Desktop), or to http://localhost:4318 when they run on the host.
TRACING__OTLP_ENDPOINT=


# =====================================================================
# Backend
# =====================================================================

# Postgres connection (compose also creates its Postgres container with these)
POSTGRES__HOST=localhost
POSTGRES__PORT=5432
POSTGRES__USERNAME=opsfleet
POSTGRES__PASSWORD=opsfleet
POSTGRES__DATABASE=opsfleet

# Agent API (backend -> agent)
AGENT_API__SCHEME=http
AGENT_API__HOSTNAME=localhost
AGENT_API__PORT=8090
AGENT_API__ENDPOINT=api/agent

# BigQuery. Queries run (and are billed) in your own GCP project; the dataset is public.
# Auth: `gcloud auth application-default login` (compose mounts it into the backend only).
# REQUIRED: your GCP project id
BIGQUERY__PROJECT_ID=
BIGQUERY__DATASET=bigquery-public-data.thelook_ecommerce
BIGQUERY__LOCATION=US
BIGQUERY__MAX_BYTES_BILLED=1073741824
BIGQUERY__MAX_ROWS=1000
BIGQUERY__QUERY_TIMEOUT_S=60
BIGQUERY__MAX_TRANSIENT_RETRIES=2

# Artifacts
ARTIFACTS__DELETION_PROPOSAL_TTL_S=300
ARTIFACTS__MAX_SEARCH_RESULTS=50


# =====================================================================
# Agent
# =====================================================================

# Gemini. compose passes the key to the agent container only.
# REQUIRED: Google AI Studio API key
GOOGLE_API_KEY=
LLM__MAIN_MODEL=gemini-3.8-flash
LLM__FALLBACK_MODEL=gemini-3.5-flash-lite
LLM__TITLE_MODEL=gemini-3.5-flash-lite
# Titles are a one-line task, so they think little (minimal, low, medium or high)
LLM__TITLE_THINKING_LEVEL=low
LLM__TIMEOUT_S=120
# Stream the main model's reasoning summaries (shown with /thoughts). Thinking tokens are billed as output.
LLM__INCLUDE_THOUGHTS=true

# Per-turn budgets
AGENT__MAX_MODEL_CALLS=20
AGENT__MAX_TOOL_CALLS=20
AGENT__MODEL_RETRIES=2

# Backend MCP servers, registered by URL
ECOMMERCE_MCP__SCHEME=http
ECOMMERCE_MCP__HOSTNAME=localhost
ECOMMERCE_MCP__PORT=8080
ECOMMERCE_MCP__ENDPOINT=mcp/ecommerce/mcp

ARTIFACTS_MCP__SCHEME=http
ARTIFACTS_MCP__HOSTNAME=localhost
ARTIFACTS_MCP__PORT=8080
ARTIFACTS_MCP__ENDPOINT=mcp/artifacts/mcp
